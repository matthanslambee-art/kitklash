{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitklash",
  "compatibility_date": "2026-08-25",
  "main": "website/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "website",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kitklash",
      "database_id": "7e2fa16a-cf19-4281-813d-5c9b6aa57d50"
    }
  ]
}
