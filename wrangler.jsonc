{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitklash",
  "compatibility_date": "2026-08-25",
  "main": "website/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "website",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sitemap.xml"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kitklash",
      "database_id": "7e2fa16a-cf19-4281-813d-5c9b6aa57d50"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "ADMIN_KEY",
      "store_id": "00f6f9e1397540fa98e45af63734581f",
      "secret_name": "admin-key"
    }
  ]
}
